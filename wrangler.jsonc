{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teacher-timetable",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "TIMETABLE_KV", "id": "a538fc1292684c83b4904cf5feb821c4" }
  ]
  // 部署后请在 Cloudflare Dashboard → Workers → teacher-timetable → Settings → Bindings
  // 添加一个 KV Namespace 绑定：
  //   Variable name: TIMETABLE_KV
  //   KV namespace:  新建或选择你的 KV（例如 teacher-timetable-kv）
  //
  // 如果使用本地 wrangler CLI 部署，也可取消下面注释并填入你的 KV id：
  // "kv_namespaces": [
  //   { "binding": "TIMETABLE_KV", "id": "YOUR_KV_NAMESPACE_ID" }
  // ]
}
